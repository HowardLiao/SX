<mxfile host="app.diagrams.net" modified="2026-10-27T08:00:00.000Z" agent="Hermes Agent" version="24.7.17" type="device"><diagram id="org_tree_2026" name="公司組織架構圖"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1450" background="#FAF7F2" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="d1_title" value="盛欣／盛碁網絡有限公司｜公司組織架構圖 (2026 年度實名編制)" style="text;html=1;fontFamily=Noto Sans TC, PingFang TC, sans-serif;fontSize=22;fontStyle=1;fontColor=#2F4538;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1200" height="36" as="geometry" /></mxCell><mxCell id="d1_subtitle" value="核定現有正式編制：25 人｜二元制衡公司治理架構（研發營運・管理總務・財務獨立雙授權）｜ISO 9001 / ISO 27001 四階制度合規管制" style="text;html=1;fontFamily=Noto Sans TC, PingFang TC, sans-serif;fontSize=12;fontColor=#6E6A64;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1200" height="22" as="geometry" /></mxCell><mxCell id="d1_legend" value="&lt;b&gt;圖例：&lt;/b&gt;&lt;font color='#1E2D24'&gt;■ 股東／董事治理層&lt;/font&gt;　&lt;font color='#2F4538'&gt;■ L3/L2 經理／副理（核心首長）&lt;/font&gt;　&lt;font color='#3E5C4B'&gt;■ L1 部門主管&lt;/font&gt;　&lt;font color='#555555'&gt;■ 專業技術與營運同仁&lt;/font&gt;　&lt;font color='#C8A96A'&gt;◆ 二元制衡隔離點&lt;/font&gt;　&lt;font color='#9C5B4A'&gt;▲ 資安兼任與職能代理&lt;/font&gt;" style="text;html=1;fontFamily=Noto Sans TC, PingFang TC, sans-serif;fontSize=11;fontColor=#2B2B2B;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1250" y="30" width="1110" height="28" as="geometry" /></mxCell><mxCell id="d1_div" value="" style="line;strokeWidth=1.5;strokeColor=#C8A96A;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="2330" height="4" as="geometry" /></mxCell><mxCell id="node_board" value="&lt;b&gt;股東會 ／ 董事會&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#C8A96A'&gt;&lt;b&gt;公司最高治理與資本決策機關&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#E8E2D9'&gt;重大投資決策・章程修訂・第一階辦法核定&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1E2D24;strokeColor=#C8A96A;strokeWidth=2;fontColor=#FAF7F2;fontFamily=Noto Sans TC;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="95" width="260" height="62" as="geometry" /></mxCell><mxCell id="node_gm" value="&lt;b&gt;總經理　吳怡慶 (A001)&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#E8E2D9'&gt;&lt;b&gt;職稱：經理/副理 ｜ L3 最高核決&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#C8A96A'&gt;綜理公司整體營運・制度委員會主任委員・第二階程序書核定&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F4538;strokeColor=#1E2D24;strokeWidth=2;fontColor=#FAF7F2;fontFamily=Noto Sans TC;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="1050" y="190" width="280" height="72" as="geometry" /></mxCell><mxCell id="edge_board_gm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6E6A64;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="node_board" target="node_gm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="node_admin_mgr" value="&lt;b&gt;管理部主管　陳建州 (A002)&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#2B2B2B'&gt;&lt;b&gt;職稱：部門主管 (L1) ｜ 代理人資總務主管&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555555'&gt;行政總務統籌・印鑑管理・資產設備維護&lt;br&gt;&lt;font color='#9C5B4A'&gt;▲ 代理人資期間：個人請購由副總經理核准&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAE6DF;strokeColor=#2F4538;strokeWidth=2;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="140" y="300" width="270" height="75" as="geometry" /></mxCell><mxCell id="node_vp" value="&lt;b&gt;副總經理　廖倫豪 博士 (B026)&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#FAF7F2'&gt;&lt;b&gt;Howard Liao Ph.D. ｜ 職稱：經理/副理 (L2)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#C8A96A'&gt;督導研發／營運／財務二元制衡・兼任資安主管・內控自評覆核&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#FAF7F2'&gt;管轄：技術研發、遊戲企劃、美術視覺、品質測試、營運客服、財務會計&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F4538;strokeColor=#C8A96A;strokeWidth=2;fontColor=#FAF7F2;fontFamily=Noto Sans TC;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1240" y="300" width="340" height="80" as="geometry" /></mxCell><mxCell id="edge_gm_admin" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6E6A64;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="node_gm" target="node_admin_mgr"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_gm_vp" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6E6A64;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="node_gm" target="node_vp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c_admin" value="&lt;b&gt;管理部 ／ 總務部 (行政總務組)&lt;/b&gt;&lt;br&gt;&lt;font size='9' color='#6E6A64'&gt;核心職能：總務驗收・公務採購・合約用印管制・前台收發&lt;/font&gt;" style="swimlane;horizontal=1;startSize=40;html=1;whiteSpace=wrap;fillColor=#E8E4DD;fontColor=#2B2B2B;swimlaneFillColor=#FAF7F2;strokeColor=#B8AFA3;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=11;fontStyle=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="50" y="430" width="450" height="460" as="geometry" /></mxCell><mxCell id="node_A076" value="&lt;table style='width:100%; border-collapse:collapse; font-family:Noto Sans TC;'&gt;&lt;tr&gt;&lt;td style='font-size:12px; font-weight:bold; color:#2F4538;'&gt;[A076] 楊芮郗&lt;/td&gt;&lt;td style='text-align:right; font-size:10px; color:#888;'&gt;到職: 2025/04/15&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='font-size:11px; font-weight:bold; color:#C8A96A; padding-top:2px;'&gt;總務部專員&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='font-size:9.5px; color:#555; padding-top:4px; line-height:1.3;'&gt;庶務採購比價、辦公用品與耗材申請、總務費用核銷、資產盤點登記&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2BBB0;strokeWidth=1;fontColor=#2B2B2B;align=left;spacing=8;" vertex="1" parent="c_admin"><mxGeometry x="20" y="55" width="410" height="110" as="geometry" /></mxCell><mxCell id="node_A087" value="&lt;table style='width:100%; border-collapse:collapse; font-family:Noto Sans TC;'&gt;&lt;tr&gt;&lt;td style='font-size:12px; font-weight:bold; color:#2F4538;'&gt;[A087] 印厚承&lt;/td&gt;&lt;td style='text-align:right; font-size:10px; color:#888;'&gt;到職: 2026/06/01&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='font-size:11px; font-weight:bold; color:#C8A96A; padding-top:2px;'&gt;總務部專員&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='font-size:9.5px; color:#555; padding-top:4px; line-height:1.3;'&gt;公務設備維護、水電通訊庶務、外包廠商修繕聯繫、公務車輛維護&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2BBB0;strokeWidth=1;fontColor=#2B2B2B;align=left;spacing=8;" vertex="1" parent="c_admin"><mxGeometry x="20" y="185" width="410" height="110" as="geometry" /></mxCell><mxCell id="node_A088" value="&lt;table style='width:100%; border-collapse:collapse; font-family:Noto Sans TC;'&gt;&lt;tr&gt;&lt;td style='font-size:12px; font-weight:bold; color:#2F4538;'&gt;[A088] 王韻庭&lt;/td&gt;&lt;td style='text-align:right; font-size:10px; color:#888;'&gt;到職: 2026/06/02&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='font-size:11px; font-weight:bold; color:#C8A96A; padding-top:2px;'&gt;總務部專員&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='font-size:9.5px; color:#555; padding-top:4px; line-height:1.3;'&gt;公司前台接待、電話轉接、信件包裹代收登錄、公文合約印鑑借出登記&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2BBB0;strokeWidth=1;fontColor=#2B2B2B;align=left;spacing=8;" vertex="1" parent="c_admin"><mxGeometry x="20" y="315" width="410" height="110" as="geometry" /></mxCell><mxCell id="edge_admin_c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6E6A64;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="node_admin_mgr" target="c_admin"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c_fin" value="&lt;b&gt;財務部 (Finance &amp; Accounting)&lt;/b&gt;&lt;br&gt;&lt;font size='9' color='#6E6A64'&gt;核心職能：IFRS 15 結轉・三單比對・網銀雙重放行&lt;/font&gt;" style="swimlane;horizontal=1;startSize=40;html=1;whiteSpace=wrap;fillColor=#F3EFEA;fontColor=#2B2B2B;swimlaneFillColor=#FAF7F2;strokeColor=#B8AFA3;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=11;fontStyle=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="530" y="430" width="290" height="540" as="geometry" /></mxCell><mxCell id="node_A003" value="&lt;b&gt;財務部主管　王慈汶 (A003)&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#2F4538'&gt;&lt;b&gt;職稱：部門主管 (L1) ｜ 到職: 2018/06/11&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555'&gt;主管財務督導・制度委員會執行秘書&lt;br&gt;&lt;font color='#C8A96A'&gt;&lt;b&gt;◆ 網銀放行 Checker ｜ 主檔覆核&lt;/b&gt;&lt;/font&gt;&lt;br&gt;資金調度・稅務申報・重大財務報表產出&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F4538;strokeWidth=2;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=10;align=left;spacing=6;" vertex="1" parent="c_fin"><mxGeometry x="15" y="50" width="260" height="110" as="geometry" /></mxCell><mxCell id="node_A082" value="&lt;b&gt;[A082] 游玉霜&lt;/b&gt;　&lt;font size='9' color='#888'&gt;到職: 2026/01/26&lt;/font&gt;&lt;br&gt;&lt;font size='10' color='#C8A96A'&gt;&lt;b&gt;財務部專員 (會計)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555' style='line-height:1.25;'&gt;應付帳款 (AP) 審核、三單比對（採購-發票-驗收）、IFRS 15 開桌耗卡營收結轉、廠商主檔建檔維護&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2BBB0;strokeWidth=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=10;align=left;spacing=6;" vertex="1" parent="c_fin"><mxGeometry x="15" y="175" width="260" height="105" as="geometry" /></mxCell><mxCell id="node_A084" value="&lt;b&gt;[A084] 賴盈築&lt;/b&gt;　&lt;font size='9' color='#888'&gt;到職: 2026/03/30&lt;/font&gt;&lt;br&gt;&lt;font size='10' color='#C8A96A'&gt;&lt;b&gt;財務部專員 (出納)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555' style='line-height:1.25;'&gt;網銀付款製單 (Maker)、零用金管理與預支款撥發、薪資批次匯款、銀行對帳單編製；嚴禁維護廠商主檔&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2BBB0;strokeWidth=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=10;align=left;spacing=6;" vertex="1" parent="c_fin"><mxGeometry x="15" y="290" width="260" height="105" as="geometry" /></mxCell><mxCell id="fin_sod_note" value="&lt;font size='9' color='#2F4538'&gt;&lt;b&gt;【SoD 雙重授權底線】&lt;/b&gt;&lt;br&gt;出納 (A084) 製單 ➔ 主管 (A003) 放行；出納嚴禁接觸廠商主檔設定權限。&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EBF1ED;strokeColor=#2F4538;strokeWidth=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=9;align=left;spacing=4;" vertex="1" parent="c_fin"><mxGeometry x="15" y="415" width="260" height="55" as="geometry" /></mxCell><mxCell id="c_art" value="&lt;b&gt;美術部 (Art &amp; Creative Design)&lt;/b&gt;&lt;br&gt;&lt;font size='9' color='#6E6A64'&gt;核心職能：國風江湖視覺・UI/UX介面・動畫特效&lt;/font&gt;" style="swimlane;horizontal=1;startSize=40;html=1;whiteSpace=wrap;fillColor=#F3EFEA;fontColor=#2B2B2B;swimlaneFillColor=#FAF7F2;strokeColor=#B8AFA3;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=11;fontStyle=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="840" y="430" width="290" height="540" as="geometry" /></mxCell><mxCell id="node_A011" value="&lt;b&gt;美術部主管　魏淑禎 (A011)&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#2F4538'&gt;&lt;b&gt;職稱：部門主管 (L1) ｜ 到職: 2019/10/01&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555'&gt;全專案視覺藝術風格總監・視覺審查&lt;br&gt;美術資源排期與分工・外包設計驗收簽核&lt;br&gt;確保客棧紅木、熊貓大俠等國風武俠風格統一&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F4538;strokeWidth=2;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=10;align=left;spacing=6;" vertex="1" parent="c_art"><mxGeometry x="15" y="50" width="260" height="105" as="geometry" /></mxCell><mxCell id="node_A012" value="&lt;b&gt;[A012] 潘羿彰&lt;/b&gt;　&lt;font size='9' color='#888'&gt;到職: 2019/10/01&lt;/font&gt;&lt;br&gt;&lt;font size='10' color='#C8A96A'&gt;&lt;b&gt;資深原畫設計師&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555' style='line-height:1.25;'&gt;角色人物設定、武俠場景原畫、棋盤牌桌國風立體質感、重點主題視覺設計&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2BBB0;strokeWidth=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=10;align=left;spacing=6;" vertex="1" parent="c_art"><mxGeometry x="15" y="165" width="260" height="92" as="geometry" /></mxCell><mxCell id="node_A057" value="&lt;b&gt;[A057] 陳俞任&lt;/b&gt;　&lt;font size='9' color='#888'&gt;到職: 2022/05/03&lt;/font&gt;&lt;br&gt;&lt;font size='10' color='#C8A96A'&gt;&lt;b&gt;遊戲 UI/UX 設計師&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555' style='line-height:1.25;'&gt;遊戲前端介面排版、HUD 資訊流設計、按鈕圖標資產規範、多解析度響應適配&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2BBB0;strokeWidth=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=10;align=left;spacing=6;" vertex="1" parent="c_art"><mxGeometry x="15" y="265" width="260" height="92" as="geometry" /></mxCell><mxCell id="node_A068" value="&lt;b&gt;[A068] 張丞佑&lt;/b&gt;　&lt;font size='9' color='#888'&gt;到職: 2024/03/01&lt;/font&gt;&lt;br&gt;&lt;font size='10' color='#C8A96A'&gt;&lt;b&gt;動態特效設計師&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555' style='line-height:1.25;'&gt;Spine 2D 骨骼動畫、粒子特效、開牌/胡牌華麗動效、宣傳短影音視覺動態&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2BBB0;strokeWidth=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=10;align=left;spacing=6;" vertex="1" parent="c_art"><mxGeometry x="15" y="365" width="260" height="92" as="geometry" /></mxCell><mxCell id="art_note" value="&lt;font size='9' color='#2F4538'&gt;&lt;b&gt;【美術風格守則】&lt;/b&gt;&lt;br&gt;堅持台味國風江湖調性，嚴禁任何時裝/外觀轉蛋要素。&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EBF1ED;strokeColor=#2F4538;strokeWidth=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=9;align=left;spacing=4;" vertex="1" parent="c_art"><mxGeometry x="15" y="475" width="260" height="45" as="geometry" /></mxCell><mxCell id="c_plan" value="&lt;b&gt;企劃部 (Game Design &amp; Planning)&lt;/b&gt;&lt;br&gt;&lt;font size='9' color='#6E6A64'&gt;核心職能：遊戲規則數值・活動規格書・版本規劃&lt;/font&gt;" style="swimlane;horizontal=1;startSize=40;html=1;whiteSpace=wrap;fillColor=#F3EFEA;fontColor=#2B2B2B;swimlaneFillColor=#FAF7F2;strokeColor=#B8AFA3;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=11;fontStyle=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1150" y="430" width="280" height="540" as="geometry" /></mxCell><mxCell id="node_A060" value="&lt;b&gt;企劃部主管　張哲豪 (A060)&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#2F4538'&gt;&lt;b&gt;職稱：部門主管 (L1) ｜ 到職: 2022/09/01&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555'&gt;主企劃・核心玩法規則設計與數值平衡&lt;br&gt;房卡與俱樂部制度規則制定・版本迭代規劃&lt;br&gt;跨研發企劃確認・產出活動規格書&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F4538;strokeWidth=2;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=10;align=left;spacing=6;" vertex="1" parent="c_plan"><mxGeometry x="15" y="50" width="250" height="110" as="geometry" /></mxCell><mxCell id="node_A033" value="&lt;b&gt;[A033] 曾翊庭&lt;/b&gt;　&lt;font size='9' color='#888'&gt;到職: 2021/02/17&lt;/font&gt;&lt;br&gt;&lt;font size='10' color='#C8A96A'&gt;&lt;b&gt;系統企劃專員&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555' style='line-height:1.25;'&gt;節慶營運活動企劃、任務與成就系統規格撰寫、玩家體驗反饋收集、功能驗收確認書編製&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2BBB0;strokeWidth=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=10;align=left;spacing=6;" vertex="1