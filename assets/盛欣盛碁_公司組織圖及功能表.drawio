l><mxCell id="c_qa" value="&lt;b&gt;測試部 (Quality Assurance)&lt;/b&gt;&lt;br&gt;&lt;font size='9' color='#6E6A64'&gt;核心職能：黑白盒測試・真機機庫・Blocker歸零&lt;/font&gt;" style="swimlane;horizontal=1;startSize=40;html=1;whiteSpace=wrap;fillColor=#F3EFEA;fontColor=#2B2B2B;swimlaneFillColor=#FAF7F2;strokeColor=#B8AFA3;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=11;fontStyle=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1770" y="430" width="270" height="540" as="geometry" /></mxCell><mxCell id="node_A049" value="&lt;b&gt;[A049] 凃睿修&lt;/b&gt;　&lt;font size='9' color='#888'&gt;到職: 2022/03/09&lt;/font&gt;&lt;br&gt;&lt;font size='10' color='#C8A96A'&gt;&lt;b&gt;資深測試工程師&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555' style='line-height:1.25;'&gt;黑白盒功能測試設計、牌局核心邏輯邊界測試、自動化測試腳本編寫、版本驗收簽署&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2BBB0;strokeWidth=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=10;align=left;spacing=6;" vertex="1" parent="c_qa"><mxGeometry x="15" y="50" width="240" height="115" as="geometry" /></mxCell><mxCell id="node_B030" value="&lt;b&gt;[B030] 蕭智瑜&lt;/b&gt;　&lt;font size='9' color='#888'&gt;到職: 2026/10/12&lt;/font&gt;&lt;br&gt;&lt;font size='10' color='#C8A96A'&gt;&lt;b&gt;QA 測試工程師&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555' style='line-height:1.25;'&gt;真機機庫 (Device Farm) 多機型相容性測試、網路延遲壓測、Bug 缺陷追蹤、Blocker 歸零檢驗&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2BBB0;strokeWidth=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=10;align=left;spacing=6;" vertex="1" parent="c_qa"><mxGeometry x="15" y="180" width="240" height="115" as="geometry" /></mxCell><mxCell id="qa_note" value="&lt;font size='9' color='#2F4538'&gt;&lt;b&gt;【品質獨立驗收】&lt;/b&gt;&lt;br&gt;測試部獨立直屬 VP 督導，享有品質一票否決權；Blocker 歸零方可發版上線。&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EBF1ED;strokeColor=#2F4538;strokeWidth=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=9;align=left;spacing=4;" vertex="1" parent="c_qa"><mxGeometry x="15" y="415" width="240" height="55" as="geometry" /></mxCell><mxCell id="c_cs" value="&lt;b&gt;營運與客服部 (Operations &amp; Support)&lt;/b&gt;&lt;br&gt;&lt;font size='9' color='#6E6A64'&gt;核心職能：AMS後台維運・7x24在線客服・防夥牌作弊仲裁&lt;/font&gt;" style="swimlane;horizontal=1;startSize=40;html=1;whiteSpace=wrap;fillColor=#F3EFEA;fontColor=#2B2B2B;swimlaneFillColor=#FAF7F2;strokeColor=#B8AFA3;strokeWidth=1.5;fontFamily=Noto Sans TC;fontSize=11;fontStyle=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="2060" y="430" width="290" height="540" as="geometry" /></mxCell><mxCell id="node_A071" value="&lt;b&gt;管理部專員 / 營運主管　謝欣燁 (A071)&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#2F4538'&gt;&lt;b&gt;管理部專員 (督導客服) ｜ 到職: 2024/10/07&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555'&gt;統籌 AMS 營運後台監控・開桌率與房卡消耗率分析&lt;br&gt;客服輪值排班・跨部門異常通報・代理商問題排查&lt;br&gt;&lt;font color='#C8A96A'&gt;&lt;b&gt;◆ 二元制衡：嚴禁私發房卡與代收貨款&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F4538;strokeWidth=2;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=10;align=left;spacing=6;" vertex="1" parent="c_cs"><mxGeometry x="15" y="50" width="260" height="110" as="geometry" /></mxCell><mxCell id="node_A081" value="&lt;b&gt;[A081] 張晉杰&lt;/b&gt;　&lt;font size='9' color='#888'&gt;到職: 2025/10/13&lt;/font&gt;&lt;br&gt;&lt;font size='10' color='#C8A96A'&gt;&lt;b&gt;客服部專員&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555' style='line-height:1.2;'&gt;7x24 第一線玩家諮詢、連線中斷申訴處理、客訴回饋即時登錄&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2BBB0;strokeWidth=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=9.5;align=left;spacing=5;" vertex="1" parent="c_cs"><mxGeometry x="15" y="170" width="260" height="80" as="geometry" /></mxCell><mxCell id="node_A086" value="&lt;b&gt;[A086] 耿舜儀&lt;/b&gt;　&lt;font size='9' color='#888'&gt;到職: 2026/06/01&lt;/font&gt;&lt;br&gt;&lt;font size='10' color='#C8A96A'&gt;&lt;b&gt;客服部專員&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555' style='line-height:1.2;'&gt;俱樂部代理商諮詢支援、開桌異常排查、工單流轉追蹤、維護通告推播&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2BBB0;strokeWidth=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=9.5;align=left;spacing=5;" vertex="1" parent="c_cs"><mxGeometry x="15" y="255" width="260" height="80" as="geometry" /></mxCell><mxCell id="node_A090" value="&lt;b&gt;[A090] 吳玟儀&lt;/b&gt;　&lt;font size='9' color='#888'&gt;到職: 2026/08/25&lt;/font&gt;&lt;br&gt;&lt;font size='10' color='#C8A96A'&gt;&lt;b&gt;客服部專員&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555' style='line-height:1.2;'&gt;同 IP / GPS 夥牌作弊監控與仲裁審查、異常牌局通報、客訴滿意度追蹤&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2BBB0;strokeWidth=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=9.5;align=left;spacing=5;" vertex="1" parent="c_cs"><mxGeometry x="15" y="340" width="260" height="80" as="geometry" /></mxCell><mxCell id="cs_note" value="&lt;font size='9' color='#2F4538'&gt;&lt;b&gt;【營運與財務隔離】&lt;/b&gt;&lt;br&gt;營運部管開桌監控，未見財務收款憑證絕不發卡。&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EBF1ED;strokeColor=#2F4538;strokeWidth=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=9;align=left;spacing=4;" vertex="1" parent="c_cs"><mxGeometry x="15" y="475" width="260" height="45" as="geometry" /></mxCell><mxCell id="edge_vp_c_fin" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2F4538;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="node_vp" target="c_fin"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_vp_c_art" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2F4538;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="node_vp" target="c_art"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_vp_c_plan" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2F4538;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="node_vp" target="c_plan"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_vp_c_tech" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2F4538;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="node_vp" target="c_tech"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_vp_c_qa" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2F4538;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="node_vp" target="c_qa"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_vp_c_cs" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2F4538;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="node_vp" target="c_cs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d1_gov_1" value="&lt;b&gt;【二元制衡核心控制點】&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#555'&gt;• &lt;b&gt;推廣部 vs 營運部職務分工&lt;/b&gt;：推廣部負責商務拓展，嚴禁持有後台發卡權限；營運部負責後台開桌監控，未見財務收款憑證嚴禁私發房卡。&lt;br&gt;• &lt;b&gt;業務紅線&lt;/b&gt;：全專案純為「房卡/開桌服務費」，嚴禁任何虛寶、道具、外觀時裝、抽卡轉蛋或涉及賭博返現機制。&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF7F2;strokeColor=#2F4538;strokeWidth=1.5;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=11;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="1010" width="740" height="90" as="geometry" /></mxCell><mxCell id="d1_gov_2" value="&lt;b&gt;【財務與付款雙重授權機制】&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#555'&gt;• &lt;b&gt;職務分工 (SoD)&lt;/b&gt;：出納 (A084 賴盈築) 製單 (Maker) ➔ 財務部主管 (A003 王慈汶) 放行 (Checker)；嚴禁單人包辦。&lt;br&gt;• &lt;b&gt;主檔防弊&lt;/b&gt;：會計 (A082 游玉霜) 建檔，財務主管覆核；出納嚴禁接觸受款廠商銀行主檔設定權限。&lt;br&gt;• &lt;b&gt;核決層級&lt;/b&gt;：L1 ≤ 30,000 部門主管 ｜ L2 ≤ 200,000 副總經理 ｜ L3 &gt; 200,000 總經理雙重放行。&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF7F2;strokeColor=#C8A96A;strokeWidth=1.5;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=11;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="820" y="1010" width="740" height="90" as="geometry" /></mxCell><mxCell id="d1_gov_3" value="&lt;b&gt;【兼任、代理與內控交叉自評】&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#555'&gt;• &lt;b&gt;資安兼任&lt;/b&gt;：技術部主管 (廖倫豪 博士) 兼任資安主管，會簽軟體/SaaS/雲端架構採購合約。&lt;br&gt;• &lt;b&gt;代理迴避&lt;/b&gt;：管理部經理 (陳建州) 代理人資總務主管期間，自身請購案件改由副總經理核准，防止自審自核。&lt;br&gt;• &lt;b&gt;交叉自評&lt;/b&gt;：由制度管理委員會每半年指派非受查部門委員執行內控交叉檢查，報告直呈總經理與董事會。&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF7F2;strokeColor=#9C5B4A;strokeWidth=1.5;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=11;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="1590" y="1010" width="760" height="90" as="geometry" /></mxCell><mxCell id="d1_author" value="Howard Liao Ph.D. ｜ 盛欣／盛碁網絡有限公司 制度管理委員會" style="text;html=1;fontFamily=Cormorant Garamond, serif;fontSize=14;fontStyle=3;fontColor=#6E6A64;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="1115" width="600" height="25" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="func_matrix_2026" name="部門功能職掌與職能矩陣表"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2100" background="#FAF7F2" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="d2_title" value="盛欣／盛碁網絡有限公司｜各部門核心功能職掌、SoD 分工與職能辭典對照表" style="text;html=1;fontFamily=Noto Sans TC, PingFang TC, sans-serif;fontSize=22;fontStyle=1;fontColor=#2F4538;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1400" height="36" as="geometry" /></mxCell><mxCell id="d2_subtitle" value="依據 ISO 9001:2015 / ISO 27001:2022 四階內控制度規範 與 個人職能盤點辭典（15項核心、管理與專業職能 L1–L5 標準）" style="text;html=1;fontFamily=Noto Sans TC, PingFang TC, sans-serif;fontSize=12;fontColor=#6E6A64;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1400" height="22" as="geometry" /></mxCell><mxCell id="d2_div" value="" style="line;strokeWidth=1.5;strokeColor=#C8A96A;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="2530" height="4" as="geometry" /></mxCell><mxCell id="d2_card_0" value="&lt;table style='width:100%; border-collapse:collapse; font-family:Noto Sans TC;'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#2F4538; color:#FAF7F2; padding:8px 10px; font-size:13px; font-weight:bold; border-radius:4px 4px 0 0;'&gt;總經理室 (General Management)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:10.5px; background:#F5F2EB; border-bottom:1px solid #E0D9CE;' colspan='2'&gt;&lt;b&gt;主管／負責人：&lt;/b&gt;&lt;font color='#2F4538'&gt;&lt;b&gt;吳怡慶 (A001)&lt;/b&gt;&lt;/font&gt; ｜ &lt;b&gt;成員編制：&lt;/b&gt;編制 1 人&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:10px; color:#555; border-bottom:1px solid #EFEAE1;' colspan='2'&gt;&lt;b&gt;核心定位：&lt;/b&gt;負責公司總體戰略方針、董事會決策執行、重大資本運作及營運合規之最高督導。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:9.5px; color:#333; line-height:1.3; vertical-align:top;' colspan='2'&gt;&lt;b&gt;主要業務職掌：&lt;/b&gt;&lt;br&gt;• 綜理全公司業務與重大營運策略決策&lt;br&gt;• 主持制度管理委員會，核定第二階程序書與制度&lt;br&gt;• L3 核決權限（&gt; 200,000 元之採購、重大支出與薪資總表）&lt;br&gt;• 銀行網銀付款之最高第二放行權限&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px; font-size:9.5px; color:#555;' colspan='2'&gt;&lt;b&gt;關鍵產出：&lt;/b&gt;&lt;font color='#2F4538'&gt;年度營運方針、年度預算核定書、全公司薪資總表核定、重大合約簽署&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px; font-size:9px; color:#9C5B4A;' colspan='2'&gt;&lt;b&gt;SoD 控制：&lt;/b&gt;L3 付款第二放行；不得兼任任何採購經辦、出納或主檔維護。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px 6px 8px; font-size:9px; color:#C8A96A; background:#FAF7F2; border-radius:0 0 4px 4px;' colspan='2'&gt;&lt;b&gt;職能要求：&lt;/b&gt;經理/副理級職能：誠信正直(L4)、顧客導向(L4)、團隊合作(L4)、領導統御(L4)、決策判斷(L4)、目標管理(L4)、品質流程(L4)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8AFA3;strokeWidth=1.5;fontColor=#2B2B2B;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="600" height="320" as="geometry" /></mxCell><mxCell id="d2_card_1" value="&lt;table style='width:100%; border-collapse:collapse; font-family:Noto Sans TC;'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#2F4538; color:#FAF7F2; padding:8px 10px; font-size:13px; font-weight:bold; border-radius:4px 4px 0 0;'&gt;副總經理室 / 技術長室 (VP / CTO)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:10.5px; background:#F5F2EB; border-bottom:1px solid #E0D9CE;' colspan='2'&gt;&lt;b&gt;主管／負責人：&lt;/b&gt;&lt;font color='#2F4538'&gt;&lt;b&gt;廖倫豪 博士 (B026)&lt;/b&gt;&lt;/font&gt; ｜ &lt;b&gt;成員編制：&lt;/b&gt;編制 1 人 (督導 20 人)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:10px; color:#555; border-bottom:1px solid #EFEAE1;' colspan='2'&gt;&lt;b&gt;核心定位：&lt;/b&gt;統籌技術研發、二元制衡治理、資安架構、制度合規及跨部門協作之營運中樞。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:9.5px; color:#333; line-height:1.3; vertical-align:top;' colspan='2'&gt;&lt;b&gt;主要業務職掌：&lt;/b&gt;&lt;br&gt;• 督導研發、營運、財務跨部門二元制衡體系&lt;br&gt;• 兼任資安主管，會簽所有 SaaS/雲端採購與資安控制&lt;br&gt;• L2 核決權限（≤ 200,000 元之採購、第三階作業指導書）&lt;br&gt;• 覆核內控自評結果；核准管理部主管代理期間之請購&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px; font-size:9.5px; color:#555;' colspan='2'&gt;&lt;b&gt;關鍵產出：&lt;/b&gt;&lt;font color='#2F4538'&gt;技術架構藍圖、SAST/DAST資安會簽意見、制度修訂審核、內控自評覆核報告&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px; font-size:9px; color:#9C5B4A;' colspan='2'&gt;&lt;b&gt;SoD 控制：&lt;/b&gt;代理管理部請購核准；兼任資安主管；不得兼任出納與財務放行。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px 6px 8px; font-size:9px; color:#C8A96A; background:#FAF7F2; border-radius:0 0 4px 4px;' colspan='2'&gt;&lt;b&gt;職能要求：&lt;/b&gt;經理/副理級職能：專業知識(L4)、問題分析(L4)、決策判斷(L4)、持續學習(L4)、領導統御(L4)、溝通協調(L4)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8AFA3;strokeWidth=1.5;fontColor=#2B2B2B;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="600" height="320" as="geometry" /></mxCell><mxCell id="d2_card_2" value="&lt;table style='width:100%; border-collapse:collapse; font-family:Noto Sans TC;'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#2F4538; color:#FAF7F2; padding:8px 10px; font-size:13px; font-weight:bold; border-radius:4px 4px 0 0;'&gt;管理部 ／ 總務部 (Admin &amp; General Affairs)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:10.5px; background:#F5F2EB; border-bottom:1px solid #E0D9CE;' colspan='2'&gt;&lt;b&gt;主管／負責人：&lt;/b&gt;&lt;font color='#2F4538'&gt;&lt;b&gt;陳建州 (A002，代理人資總務主管)&lt;/b&gt;&lt;/font&gt; ｜ &lt;b&gt;成員編制：&lt;/b&gt;楊芮郗 (A076)、印厚承 (A087)、王韻庭 (A088)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:10px; color:#555; border-bottom:1px solid #EFEAE1;' colspan='2'&gt;&lt;b&gt;核心定位：&lt;/b&gt;統籌行政事務、公務採購、資產設施維護、前台接待及公文合約用印管制。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:9.5px; color:#333; line-height:1.3; vertical-align:top;' colspan='2'&gt;&lt;b&gt;主要業務職掌：&lt;/b&gt;&lt;br&gt;• 負責辦公用品、設備維護、車輛租賃及總務採購比價&lt;br&gt;• 執行「總務驗收」（辦公物料、清潔維護、行銷實物）&lt;br&gt;• 公司大章保管與用印登記簿（CON-F-03）控管&lt;br&gt;• 前台訪客接待、郵件包裹代收登錄（代收不等同驗收）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px; font-size:9.5px; color:#555;' colspan='2'&gt;&lt;b&gt;關鍵產出：&lt;/b&gt;&lt;font color='#2F4538'&gt;總務驗收單、用印登記簿、合約管理清冊、資產盤點表、採購比價單&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px; font-size:9px; color:#9C5B4A;' colspan='2'&gt;&lt;b&gt;SoD 控制：&lt;/b&gt;請購下單人員不得驗收；代理人資期間自身請購改由副總經理核准。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px 6px 8px; font-size:9px; color:#C8A96A; background:#FAF7F2; border-radius:0 0 4px 4px;' colspan='2'&gt;&lt;b&gt;職能要求：&lt;/b&gt;部門主管級職能：誠信正直(L4)、團隊合作(L3)、溝通協調(L3)、品質與流程管理(L3)、專業知識(L4)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8AFA3;strokeWidth=1.5;fontColor=#2B2B2B;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1310" y="100" width="600" height="320" as="geometry" /></mxCell><mxCell id="d2_card_3" value="&lt;table style='width:100%; border-collapse:collapse; font-family:Noto Sans TC;'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#2F4538; color:#FAF7F2; padding:8px 10px; font-size:13px; font-weight:bold; border-radius:4px 4px 0 0;'&gt;財務部 (Finance &amp; Accounting)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:10.5px; background:#F5F2EB; border-bottom:1px solid #E0D9CE;' colspan='2'&gt;&lt;b&gt;主管／負責人：&lt;/b&gt;&lt;font color='#2F4538'&gt;&lt;b&gt;王慈汶 (A003，主管)&lt;/b&gt;&lt;/font&gt; ｜ &lt;b&gt;成員編制：&lt;/b&gt;游玉霜 (A082，會計)、賴盈築 (A084，出納)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:10px; color:#555; border-bottom:1px solid #EFEAE1;' colspan='2'&gt;&lt;b&gt;核心定位：&lt;/b&gt;負責公司會計帳務、三單比對、出納收付、IFRS 15 營收結轉及資金風控。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:9.5px; color:#333; line-height:1.3; vertical-align:top;' colspan='2'&gt;&lt;b&gt;主要業務職掌：&lt;/b&gt;&lt;br&gt;• 會計：發票憑證審核、供應商主檔建檔、IFRS 15 開桌耗卡營收動態結轉&lt;br&gt;• 出納：網銀付款製單 (Maker)、零用金撥付、薪資轉帳&lt;br&gt;• 主管：網銀付款放行 (Checker)、廠商主檔覆核、稅務申報、制度委員會執行秘書&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px; font-size:9.5px; color:#555;' colspan='2'&gt;&lt;b&gt;關鍵產出：&lt;/b&gt;&lt;font color='#2F4538'&gt;損益表/資產負債表、IFRS 15 營收結轉表、付款覆核放行表、薪資覆核檢核表&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px; font-size:9px; color:#9C5B4A;' colspan='2'&gt;&lt;b&gt;SoD 控制：&lt;/b&gt;嚴格實施雙重授權（出納製單、主管放行）；出納嚴禁接觸受款廠商主檔維護。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px 6px 8px; font-size:9px; color:#C8A96A; background:#FAF7F2; border-radius:0 0 4px 4px;' colspan='2'&gt;&lt;b&gt;職能要求：&lt;/b&gt;專業職能專家/主管級：專業知識(L4)、品質與流程管理(L4)、問題分析(L3)、誠信正直(L4)、目標管理(L3)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8AFA3;strokeWidth=1.5;fontColor=#2B2B2B;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1940" y="100" width="600" height="320" as="geometry" /></mxCell><mxCell id="d2_card_4" value="&lt;table style='width:100%; border-collapse:collapse; font-family:Noto Sans TC;'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#2F4538; color:#FAF7F2; padding:8px 10px; font-size:13px; font-weight:bold; border-radius:4px 4px 0 0;'&gt;技術部 (Engineering &amp; Architecture)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:10.5px; background:#F5F2EB; border-bottom:1px solid #E0D9CE;' colspan='2'&gt;&lt;b&gt;主管／負責人：&lt;/b&gt;&lt;font color='#2F4538'&gt;&lt;b&gt;鄭元翔 (A066，架構領隊)&lt;/b&gt;&lt;/font&gt; ｜ &lt;b&gt;成員編制：&lt;/b&gt;趙柏凱 (A022)、林秉韶 (A051)、林琮緯 (B029)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:10px; color:#555; border-bottom:1px solid #EFEAE1;' colspan='2'&gt;&lt;b&gt;核心定位：&lt;/b&gt;主導遊戲客戶端、WebSocket 高併發微服務、CSPRNG 洗牌及雲原生架構開發與維運。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:9.5px; color:#333; line-height:1.3; vertical-align:top;' colspan='2'&gt;&lt;b&gt;主要業務職掌：&lt;/b&gt;&lt;br&gt;• 架構：微服務架構設計、核心高併發分散式叢集、代碼審查&lt;br&gt;• 後端：CSPRNG 公平洗牌算法（GLI-19標準）、房間牌局調度、開桌扣卡邏輯&lt;br&gt;• 前端：Unity/Cocos 遊戲前端邏輯、網路重連、UI交互、效能調校&lt;br&gt;• DevOps：K8s 編排、CI/CD 交付流水線、SAST/DAST 弱點掃描修復&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px; font-size:9.5px; color:#555;' colspan='2'&gt;&lt;b&gt;關鍵產出：&lt;/b&gt;&lt;font color='#2F4538'&gt;系統架構設計書、API 規範、GLI-19洗牌認證算法、CI/CD 部署腳本、單元測試&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px; font-size:9px; color:#9C5B4A;' colspan='2'&gt;&lt;b&gt;SoD 控制：&lt;/b&gt;技術部獨立執行技術類驗收；工程師代碼必須經架構領隊 PR 覆核方可合併。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px 6px 8px; font-size:9px; color:#C8A96A; background:#FAF7F2; border-radius:0 0 4px 4px;' colspan='2'&gt;&lt;b&gt;職能要求：&lt;/b&gt;專業技術專家級：專業技術／工具應用(L4)、問題分析與解決(L4)、專業知識(L4)、持續學習(L3)、數位資訊應用(L3)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8AFA3;strokeWidth=1.5;fontColor=#2B2B2B;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="440" width="600" height="320" as="geometry" /></mxCell><mxCell id="d2_card_5" value="&lt;table style='width:100%; border-collapse:collapse; font-family:Noto Sans TC;'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#2F4538; color:#FAF7F2; padding:8px 10px; font-size:13px; font-weight:bold; border-radius:4px 4px 0 0;'&gt;企劃部 (Game Design &amp; Planning)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:10.5px; background:#F5F2EB; border-bottom:1px solid #E0D9CE;' colspan='2'&gt;&lt;b&gt;主管／負責人：&lt;/b&gt;&lt;font color='#2F4538'&gt;&lt;b&gt;張哲豪 (A060，主企劃)&lt;/b&gt;&lt;/font&gt; ｜ &lt;b&gt;成員編制：&lt;/b&gt;曾翊庭 (A033)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:10px; color:#555; border-bottom:1px solid #EFEAE1;' colspan='2'&gt;&lt;b&gt;核心定位：&lt;/b&gt;規劃符合台味國風調性之麻將暗棋規則、數值平衡、活動規格書及版本迭代。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:9.5px; color:#333; line-height:1.3; vertical-align:top;' colspan='2'&gt;&lt;b&gt;主要業務職掌：&lt;/b&gt;&lt;br&gt;• 主企劃：核心棋牌玩法規則、數值經濟模型、俱樂部房卡計費模型規劃&lt;br&gt;• 系統企劃：營運活動規格書編寫、成就/任務系統設計、介面流程規劃&lt;br&gt;• 業務紅線管制：嚴格確保產品僅有房卡/服務費，無任何虛寶轉蛋&lt;br&gt;• 與技術部、美術部召開規格對齊會議並確認驗收交付&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px; font-size:9.5px; color:#555;' colspan='2'&gt;&lt;b&gt;關鍵產出：&lt;/b&gt;&lt;font color='#2F4538'&gt;遊戲企劃規格書 (GDD)、活動規格書 (FDD)、數值模型試算表、版本發布說明&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px; font-size:9px; color:#9C5B4A;' colspan='2'&gt;&lt;b&gt;SoD 控制：&lt;/b&gt;企劃部確認功能符合性驗收；不得直接修改後台資料庫或程式碼。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px 6px 8px; font-size:9px; color:#C8A96A; background:#FAF7F2; border-radius:0 0 4px 4px;' colspan='2'&gt;&lt;b&gt;職能要求：&lt;/b&gt;專業/主管職能：創新改善(L3)、顧客導向(L3)、專業知識(L4)、溝通協調(L3)、問題分析與解決(L3)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8AFA3;strokeWidth=1.5;fontColor=#2B2B2B;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="680" y="440" width="600" height="320" as="geometry" /></mxCell><mxCell id="d2_card_6" value="&lt;table style='width:100%; border-collapse:collapse; font-family:Noto Sans TC;'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#2F4538; color:#FAF7F2; padding:8px 10px; font-size:13px; font-weight:bold; border-radius:4px 4px 0 0;'&gt;美術部 (Art &amp; Creative Design)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:10.5px; background:#F5F2EB; border-bottom:1px solid #E0D9CE;' colspan='2'&gt;&lt;b&gt;主管／負責人：&lt;/b&gt;&lt;font color='#2F4538'&gt;&lt;b&gt;魏淑禎 (A011，主管)&lt;/b&gt;&lt;/font&gt; ｜ &lt;b&gt;成員編制：&lt;/b&gt;潘羿彰 (A012)、陳俞任 (A057)、張丞佑 (A068)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:10px; color:#555; border-bottom:1px solid #EFEAE1;' colspan='2'&gt;&lt;b&gt;核心定位：&lt;/b&gt;打造沉浸式台味國風江湖武俠視覺體驗（客棧紅木、熊貓大俠潘達、精美UI）。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:9.5px; color:#333; line-height:1.3; vertical-align:top;' colspan='2'&gt;&lt;b&gt;主要業務職掌：&lt;/b&gt;&lt;br&gt;• 主管：視覺風格總監、美術資源排程、外包設計規格審查與簽收驗收&lt;br&gt;• 原畫：角色原畫設計、武俠國風場景繪製、棋盤立體質感資產產出&lt;br&gt;• UI/UX：前端遊戲介面佈局、按鈕/彈窗元件庫、高解析度自適應切圖&lt;br&gt;• 動效：Spine 骨骼動畫、胡牌開牌粒子動效、宣傳短影音視覺後製&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px; font-size:9.5px; color:#555;' colspan='2'&gt;&lt;b&gt;關鍵產出：&lt;/b&gt;&lt;font color='#2F4538'&gt;美術規範手冊、角色/場景原畫圖檔、UI 元件庫 (PSD/Figma)、Spine 動畫資源包&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px; font-size:9px; color:#9C5B4A;' colspan='2'&gt;&lt;b&gt;SoD 控制：&lt;/b&gt;美術部負責美術外包成品成果確認；不得擔任自身外包採購案之比價採購人。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px 6px 8px; font-size:9px; color:#C8A96A; background:#FAF7F2; border-radius:0 0 4px 4px;' colspan='2'&gt;&lt;b&gt;職能要求：&lt;/b&gt;專業職能專家級：專業技術／工具應用(L4)、創新改善(L3)、品質與流程管理(L3)、團隊合作(L3)、顧客導向(L3)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8AFA3;strokeWidth=1.5;fontColor=#2B2B2B;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1310" y="440" width="600" height="320" as="geometry" /></mxCell><mxCell id="d2_card_7" value="&lt;table style='width:100%; border-collapse:collapse; font-family:Noto Sans TC;'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#2F4538; color:#FAF7F2; padding:8px 10px; font-size:13px; font-weight:bold; border-radius:4px 4px 0 0;'&gt;測試部 (QA) 與 營運客服部 (Ops &amp; CS)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:10.5px; background:#F5F2EB; border-bottom:1px solid #E0D9CE;' colspan='2'&gt;&lt;b&gt;主管／負責人：&lt;/b&gt;&lt;font color='#2F4538'&gt;&lt;b&gt;凃睿修 (A049，QA) ｜ 謝欣燁 (A071，營運客服)&lt;/b&gt;&lt;/font&gt; ｜ &lt;b&gt;成員編制：&lt;/b&gt;蕭智瑜 (B030，QA) ｜ 張晉杰 (A081)、耿舜儀 (A086)、吳玟儀 (A090)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:10px; color:#555; border-bottom:1px solid #EFEAE1;' colspan='2'&gt;&lt;b&gt;核心定位：&lt;/b&gt;測試部把關發版品質；營運客服部監控開桌後台、防作弊仲裁並提供 7x24 客服。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px; font-size:9.5px; color:#333; line-height:1.3; vertical-align:top;' colspan='2'&gt;&lt;b&gt;主要業務職掌：&lt;/b&gt;&lt;br&gt;• QA：黑白盒測試、自動化測試、相容性機庫壓測、Blocker 歸零檢驗&lt;br&gt;• 營運：AMS 後台監控、開桌消耗率分析、同 IP/GPS 夥牌作弊監控與仲裁&lt;br&gt;• 客服：7x24 玩家諮詢、俱樂部代理商客訴處置、緊急障礙回報與工單流轉&lt;br&gt;• 二元制衡：營運部未見財務收款憑證嚴禁私發房卡，嚴禁代收貨款&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px; font-size:9.5px; color:#555;' colspan='2'&gt;&lt;b&gt;關鍵產出：&lt;/b&gt;&lt;font color='#2F4538'&gt;QA 測試報告 (Blocker歸零證明)、AMS營運日報、作弊仲裁處置紀錄、客服週報&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px; font-size:9px; color:#9C5B4A;' colspan='2'&gt;&lt;b&gt;SoD 控制：&lt;/b&gt;QA 擁有一票否決權；營運客服部嚴禁接觸任何收款與未授權劃撥權限。&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px 8px 6px 8px; font-size:9px; color:#C8A96A; background:#FAF7F2; border-radius:0 0 4px 4px;' colspan='2'&gt;&lt;b&gt;職能要求：&lt;/b&gt;專業/執行級職能：品質與流程管理(L3)、問題分析與解決(L3)、顧客導向(L3)、誠信正直(L4)、溝通協調(L3)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8AFA3;strokeWidth=1.5;fontColor=#2B2B2B;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1940" y="440" width="600" height="320" as="geometry" /></mxCell><mxCell id="d2_sec2_title" value="&lt;b&gt;組織職能評核要求等級矩陣表 (Competency Requirements Matrix)&lt;/b&gt; ｜ 依據『1.職能辭典』與『2.職務職能需求』" style="text;html=1;fontFamily=Noto Sans TC;fontSize=15;fontStyle=1;fontColor=#2F4538;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="790" width="1200" height="28" as="geometry" /></mxCell><mxCell id="d2_matrix_table" value="&lt;table style='width:100%; border-collapse:collapse; font-family:Noto Sans TC; border:1px solid #B8AFA3;'&gt;&lt;tr style='background:#2F4538; color:#FAF7F2; font-size:11px;'&gt;&lt;th style='padding:8px 6px; width:75px;'&gt;職能類別&lt;/th&gt;&lt;th style='padding:8px 6px; width:45px;'&gt;代碼&lt;/th&gt;&lt;th style='padding:8px 6px; width:130px;'&gt;職能項目&lt;/th&gt;&lt;th style='padding:8px 8px;'&gt;職能核心定義與內涵&lt;/th&gt;&lt;th style='padding:8px 6px; width:100px;'&gt;經理／副理&lt;br&gt;(L3 / L2)&lt;/th&gt;&lt;th style='padding:8px 6px; width:100px;'&gt;部門主管&lt;br&gt;(L1)&lt;/th&gt;&lt;th style='padding:8px 6px; width:100px;'&gt;專家／架構師&lt;br&gt;(Expert)&lt;/th&gt;&lt;th style='padding:8px 6px; width:100px;'&gt;進階資深&lt;br&gt;(Advanced)&lt;/th&gt;&lt;th style='padding:8px 6px; width:100px;'&gt;基礎專員&lt;br&gt;(Basic)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 6px; font-weight:bold; background:#EAE6DF; font-size:10px; text-align:center;'&gt;核心職能&lt;/td&gt;&lt;td style='padding:5px 6px; font-weight:bold; font-size:10px; text-align:center; color:#2F4538;'&gt;C01&lt;/td&gt;&lt;td style='padding:5px 6px; font-weight:bold; font-size:10px; color:#2F4538;'&gt;誠信正直&lt;/td&gt;&lt;td style='padding:5px 8px; font-size:9.5px; color:#555;'&gt;遵守法規與公司規範，言行一致、信守承諾，維護組織信譽。&lt;/td&gt;&lt;td style='padding:5px 6px; font-size:10px; text-align:center; font-weight:bold; background:#F2EFE9; color:#2F4538;'&gt;L4 精通&lt;/td&gt;&lt;td style='padding:5px 6px; font-size:10px; text-align:center; font-weight:bold; background:#FAF7F2; color:#2F4538;'&gt;L4 精通&lt;/td&gt;&lt;td style='padding:5px 6px; font-size:10px; text-align:center; font-weight:bold; background:#F2EFE9; color:#6E6A64;'&gt;L3 熟練&lt;/td&gt;&lt;td style='padding:5px 6px; font-size:10px; text-align:center; font-weight:bold; background:#FAF7F2; color:#6E6A64;'&gt;L3 熟練&lt;/td&gt;&lt;td style='padding:5px 6px; font-size:10px; text-align:center; font-weight:bold; background:#F2EFE9; color:#888;'&gt;L3 熟練&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 6px; font-weight:bold; background:#EAE6DF; font-size:10px; text-align:center;'&gt;核心職能&lt;/td&gt;&lt;td style='padding:5px 6px; font-weight:bold; font-size:10px; text-align:center; color:#2F4538;'&gt;C02&lt;/td&gt;&lt;td style='padding:5px 6px; font-weight:bold; font-size:10px; color:#2F4538;'&gt;顧客導向&lt;/td&gt;&lt;td style='padding:5px 8px; font-size:9.5px; color:#555;'&gt;了解內外部顧客需求，主動提供有價值的服務與解決方案。&lt;/td&gt;&lt;td style='padding:5px 6px; font-size:10px; text-align:center; font-weight:bold; background:#F2EFE9; color:#2F4538;'&gt;L4 精通&lt;/td&gt;&lt;td style='padding:5px 6px; font-size:10px; text-align:center; font-weight:bold; background:#FAF7F2; color:#2F4538;'&gt;L3 熟練&lt;/td&gt;&lt;td style='padding:5px 6px; font-size:10px; text-align:center; font-weight:bold; background:#F2EFE9; color:#6E6A64;'&gt;L3 熟練&lt;/td&gt;&lt;td style='padding:5px 6px; font-size:10px; text-align:center; font-weight:bold; background:#FAF7F2; color:#6E6A64;'&gt;L3 熟練&lt;/td&gt;&lt;td style='padding:5px 6px; font-size:10px; text-align:center; font-weight:bold; background:#F2EFE9; color:#888;'&gt;L2 執行&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 6px; font-weight:bold; background:#EAE6DF; font-size:10px; text-align:center;'&gt;核心職能&lt;/td&gt;&lt;td style='padding:5px 6px; font-weight:bold; font-size:10px; text-align:center; color:#2F4538;'&gt;C03&lt;/td&gt;&lt;td style='padding:5px 6px; font-weight:bold; font-size:10px; color:#2F4538;'&gt;團隊合作&lt;/td&gt;&lt;td style='padding:5px 8px; font-size:9.5px; color:#555;'&gt;跨部門協作、分享資訊與資源，共同達成團隊目標。&lt;/td&gt;&lt;td style='padding:5px 6px; font-size:10px; text-align:center; font-weight:bold; background:#F2EFE9; color:#2F4538;'&gt;L4 精通&lt;/td&gt;&lt;td style='padding:5px 6px; font-size:10px; text-align:center; font-weight:bold; background:#FAF7F2; color:#2F4538;'&gt;L3 熟練&lt;/td&gt;&lt;td style='padding:5px 6px; font-size:10px; text-align:center; font-weight:bold; background:#F2EFE9; color:#6E6A64;'&gt;L3 熟練&lt;/td&gt;&lt;td style='padding:5px 6px; font-size:10px; text-align:center; font-weight:bold; background:#FAF7F2; color:#6E6A64;'&gt;L3 熟練&lt;/td&gt;&lt;td style='padding:5px 6px; font-size:10px; text-align:center; font-weight:bold; background:#F2EFE9; color:#888;'&gt;L3 熟練&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 6px; font-weight:bold; background:#EAE6DF; font-size:10px; text-align:center;'&gt;核心職能&lt;/td&gt;&lt;td style='padding:5px 6px; font-weight:bold; font-size:10px; text-align:center; color:#2F4538;'&gt;C04&lt;/td&gt;&lt;td style='padding:5px 6px; font-weight:bold; font-size:10px; color:#2F4538;'&gt;持續學習&lt;/td&gt;&lt;td style='padding:5px 8p