<mxfile host="app.diagrams.net" modified="2026-10-30T12:00:00.000Z" agent="Hermes Agent" version="24.7.17" type="device"><diagram id="functional_org" name="一、功能性組織圖"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1550" background="#FAF7F2" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="d1_title" value="盛欣、盛碁科技網絡｜功能性組織架構圖 (Functional Organization Chart)" style="text;html=1;fontFamily=Noto Sans TC, PingFang TC, sans-serif;fontSize=22;fontStyle=1;fontColor=#1f3864;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1200" height="36" as="geometry" /></mxCell><mxCell id="d1_subtitle" value="依據《個人職能盤點_總表_產品線版.xlsx》與 ISO 四階治理手冊 (P2P-GOV-00) ｜ 總人數 25 人（法務委外不計）｜ 行政三級核決體系 (L3/L2/L1)" style="text;html=1;fontFamily=Noto Sans TC, PingFang TC, sans-serif;fontSize=12;fontColor=#5d6779;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1200" height="22" as="geometry" /></mxCell><mxCell id="d1_legend" value="&lt;b&gt;圖例：&lt;/b&gt;&lt;font color='#1f3864'&gt;■ 總經理 (L3核決)&lt;/font&gt;　&lt;font color='#2F4538'&gt;■ 副總經理 (L2核決/審簽/資安)&lt;/font&gt;　&lt;font color='#a8372b'&gt;■ 部門主管 (L1核決)&lt;/font&gt;　&lt;font color='#5d6779'&gt;-- 幕僚/法務 (委外)&lt;/font&gt;" style="text;html=1;fontFamily=Noto Sans TC, PingFang TC, sans-serif;fontSize=11;fontColor=#2B2B2B;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1350" y="30" width="1010" height="28" as="geometry" /></mxCell><mxCell id="d1_div" value="" style="line;strokeWidth=1.5;strokeColor=#1f3864;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="4" as="geometry" /></mxCell><mxCell id="n1_board" value="&lt;b&gt;股東會 ／ 董事會&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#C8A96A'&gt;&lt;b&gt;公司最高治理與決策機關&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#E8E2D9'&gt;重大投資方針・章程修訂・第一階管理辦法 (P2P-POL-01) 核定&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#18233a;strokeColor=#C8A96A;strokeWidth=2;fontColor=#FAF7F2;fontFamily=Noto Sans TC;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="1040" y="95" width="280" height="62" as="geometry" /></mxCell><mxCell id="n1_gm" value="&lt;b&gt;總經理　吳怡慶 (A001)&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#E8E2D9'&gt;&lt;b&gt;職稱：經理/副理 ｜ L3 最高核決層級 ｜ 職能別: 經營&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#C8A96A'&gt;綜理公司整體營運・主持制度管理委員會・第二階程序書核定・網銀付款第二放行&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1f3864;strokeColor=#18233a;strokeWidth=2;fontColor=#FAF7F2;fontFamily=Noto Sans TC;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="1020" y="190" width="320" height="72" as="geometry" /></mxCell><mxCell id="n1_legal" value="&lt;b&gt;法務 (委外)&lt;/b&gt;&lt;br&gt;&lt;font size='9' color='#5d6779'&gt;合約法律諮詢・直接委任&lt;/font&gt;&lt;br&gt;&lt;span style='background:#eceff5; color:#5d6779; font-size:9px; padding:1px 6px; border-radius:3px;'&gt;直屬總經理&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5d6779;strokeWidth=1.5;strokeDashed=1;dashed=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1250" y="248" width="180" height="62" as="geometry" /></mxCell><mxCell id="e1_board_gm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6E6A64;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n1_board" target="n1_gm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_gm_legal" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5d6779;strokeWidth=1.5;strokeDashed=1;dashed=1;endArrow=none;" edge="1" parent="1" source="n1_gm" target="n1_legal"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n1_adm" value="&lt;b&gt;管理部主管　陳建州 (A002)&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#2B2B2B'&gt;&lt;b&gt;部門主管 (L1) ｜ 直屬: 總經理 吳怡慶&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555'&gt;部門: 管理部/人資總務部/營運行銷部 ｜ 職能: 營運、管理&lt;br&gt;負責產品: 鬥陣歡樂城 ｜ 代理人資總務主管&lt;br&gt;&lt;font color='#a8372b'&gt;&lt;b&gt;▲ 簽核先經副總經理廖倫豪審簽，再呈總經理核決&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1EEE6;strokeColor=#1f3864;strokeWidth=2;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="100" y="300" width="330" height="90" as="geometry" /></mxCell><mxCell id="n1_vp" value="&lt;b&gt;副總經理　廖倫豪 博士 (B026)&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#FAF7F2'&gt;&lt;b&gt;Howard Liao Ph.D. ｜ 職稱：經理/副理 (L2) ｜ 直屬: 吳怡慶&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#C8A96A'&gt;督導研發、企劃、美術、測試、客服 ｜ 審簽管理部與財務部簽核文件&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#FAF7F2'&gt;兼任資安主管 ｜ 制度委員會覆核 ｜ 排定跨產品研發優先順序&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F4538;strokeColor=#C8A96A;strokeWidth=2;fontColor=#FAF7F2;fontFamily=Noto Sans TC;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="970" y="300" width="420" height="90" as="geometry" /></mxCell><mxCell id="n1_fin" value="&lt;b&gt;財務部主管　王慈汶 (A003)&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#2B2B2B'&gt;&lt;b&gt;部門主管 (L1) ｜ 直屬: 總經理 吳怡慶&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555'&gt;部門: 財務部 ｜ 職能: 財務 ｜ 負責產品: 公司共用&lt;br&gt;制度管理委員會執行秘書 ｜ 稅務申報與財務報表&lt;br&gt;&lt;font color='#a8372b'&gt;&lt;b&gt;▲ 簽核先經副總經理審簽，再呈總經理核決 ｜ 放行Checker&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1EEE6;strokeColor=#1f3864;strokeWidth=2;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1940" y="300" width="340" height="90" as="geometry" /></mxCell><mxCell id="e1_gm_n1_adm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6E6A64;strokeW