 Sans TC;fontSize=9.5;align=left;spacing=6;" vertex="1" parent="c1_team_cs"><mxGeometry x="10" y="42" width="255" height="115" as="geometry" /></mxCell><mxCell id="n1_mem_A081" value="&lt;b&gt;[A081] 張晉杰&lt;/b&gt;　&lt;font size='9' color='#888'&gt;2025/10/13&lt;/font&gt;&lt;br&gt;&lt;font size='10' color='#1f3864'&gt;&lt;b&gt;職稱: (基礎) ｜ 職能: 客服&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#a8372b'&gt;負責產品: 兩款共用&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555'&gt;7x24 第一線玩家諮詢、連線中斷排查、客訴登錄&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2BBB0;strokeWidth=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=9;align=left;spacing=5;" vertex="1" parent="c1_team_cs"><mxGeometry x="10" y="168" width="255" height="105" as="geometry" /></mxCell><mxCell id="n1_mem_A086" value="&lt;b&gt;[A086] 耿舜儀&lt;/b&gt;　&lt;font size='9' color='#888'&gt;2026/06/01&lt;/font&gt;&lt;br&gt;&lt;font size='10' color='#1f3864'&gt;&lt;b&gt;職稱: (基礎) ｜ 職能: 客服&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#a8372b'&gt;負責產品: 兩款共用&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555'&gt;俱樂部代理商諮詢支援、開桌異常排查、工單流轉&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2BBB0;strokeWidth=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=9;align=left;spacing=5;" vertex="1" parent="c1_team_cs"><mxGeometry x="10" y="283" width="255" height="105" as="geometry" /></mxCell><mxCell id="n1_mem_A090" value="&lt;b&gt;[A090] 吳玟儀&lt;/b&gt;　&lt;font size='9' color='#888'&gt;2026/08/25&lt;/font&gt;&lt;br&gt;&lt;font size='10' color='#1f3864'&gt;&lt;b&gt;職稱: (基礎) ｜ 職能: 客服&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#a8372b'&gt;負責產品: 兩款共用&lt;/font&gt;&lt;br&gt;&lt;font size='9' color='#555'&gt;同 IP / GPS 夥牌作弊監控與仲裁審查、異常牌局通報&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2BBB0;strokeWidth=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=9;align=left;spacing=5;" vertex="1" parent="c1_team_cs"><mxGeometry x="10" y="398" width="255" height="105" as="geometry" /></mxCell><mxCell id="e1_vp_to_cs" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2F4538;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n1_vp" target="c1_team_cs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d1_note_box1" value="&lt;b&gt;【行政匯報與簽核流程】&lt;/b&gt;&lt;br&gt;&lt;font size='9.5' color='#555'&gt;• &lt;b&gt;簽核三級體系&lt;/b&gt;：管理部、財務部直屬總經理，簽核文件先經副總經理廖倫豪審簽，再呈總經理核決。&lt;br&gt;• &lt;b&gt;資安兼任&lt;/b&gt;：技術部主管 (廖倫豪 博士) 兼任資安主管，會簽軟體/SaaS/雲端架構採購合約。&lt;br&gt;• &lt;b&gt;法務委外&lt;/b&gt;：直接由總經理委任，提供全公司合約與智財法律顧問支援。&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1f3864;strokeWidth=1.5;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=10;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="1040" width="1100" height="85" as="geometry" /></mxCell><mxCell id="d1_note_box2" value="&lt;b&gt;【財務雙授權與二元制衡】&lt;/b&gt;&lt;br&gt;&lt;font size='9.5' color='#555'&gt;• &lt;b&gt;雙重放行&lt;/b&gt;：出納 (A084 賴盈築) 製單 ➔ 財務主管 (A003 王慈汶) 放行；出納嚴禁接觸受款廠商主檔設定。&lt;br&gt;• &lt;b&gt;推廣 vs 營運隔離&lt;/b&gt;：推廣人員嚴禁持有 AMS 後台發卡權限；營運部未見財務收款憑證嚴禁私發房卡。&lt;br&gt;• &lt;b&gt;業務紅線&lt;/b&gt;：全專案純為「房卡/開桌服務費」，嚴禁任何虛寶、道具、外觀時裝或抽卡轉蛋。&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#a8372b;strokeWidth=1.5;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=10;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1210" y="1040" width="1100" height="85" as="geometry" /></mxCell><mxCell id="d1_author" value="Howard Liao Ph.D. ｜ 盛欣、盛碁科技網絡 制度管理委員會 謹訂" style="text;html=1;fontFamily=Cormorant Garamond, serif;fontSize=14;fontStyle=3;fontColor=#5d6779;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1140" width="600" height="25" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="product_line_org" name="二、產品線組織圖"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1650" background="#FAF7F2" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="d2_title" value="盛欣、盛碁科技網絡｜產品線矩陣組織架構圖 (Product-Line Matrix Organization Chart)" style="text;html=1;fontFamily=Noto Sans TC, PingFang TC, sans-serif;fontSize=22;fontStyle=1;fontColor=#1f3864;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1400" height="36" as="geometry" /></mxCell><mxCell id="d2_subtitle" value="組織架構 ｜ 依產品線劃分．弱矩陣型 ｜ 總人數 25 人（法務委外不計）｜ 兩款產品（鬥陣歡樂城、寵物遊戲）＋ 共用研發 ＋ 共用客服 ＋ 管理中心" style="text;html=1;fontFamily=Noto Sans TC, PingFang TC, sans-serif;fontSize=12;fontColor=#5d6779;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1400" height="22" as="geometry" /></mxCell><mxCell id="d2_legend" value="&lt;b&gt;圖例：&lt;/b&gt;&lt;font color='#a8372b'&gt;■ 鬥陣歡樂城 (棋牌)&lt;/font&gt;　&lt;font color='#22705f'&gt;■ 寵物遊戲 (寵物)&lt;/font&gt;　&lt;font color='#1f3864'&gt;■ 兩款共用單位 (研發/客服)&lt;/font&gt;　&lt;font color='#5d6779'&gt;■ 公司共用管理中心&lt;/font&gt;　&lt;font color='#5d6779'&gt;-- 委外法務&lt;/font&gt;" style="text;html=1;fontFamily=Noto Sans TC, PingFang TC, sans-serif;fontSize=11;fontColor=#2B2B2B;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1250" y="30" width="1110" height="28" as="geometry" /></mxCell><mxCell id="d2_div" value="" style="line;strokeWidth=1.5;strokeColor=#1f3864;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2320" height="4" as="geometry" /></mxCell><mxCell id="n2_gm" value="&lt;b&gt;總經理　吳怡慶 (A001)&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#E8E2D9'&gt;綜理兩大產品線與公司全般治理&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1f3864;strokeColor=#18233a;strokeWidth=2;fontColor=#FAF7F2;fontFamily=Noto Sans TC;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="95" width="280" height="60" as="geometry" /></mxCell><mxCell id="n2_legal" value="&lt;b&gt;法務 (委外)&lt;/b&gt;&lt;br&gt;&lt;font size='9' color='#5d6779'&gt;直接委任 ｜ 直屬總經理&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5d6779;strokeWidth=1.5;strokeDashed=1;dashed=1;fontColor=#2B2B2B;fontFamily=Noto Sans TC;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1260" y="130" width="160" height="54" as="geometry" /></mxCell><mxCell id="e2_gm_legal" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5d6779;strokeWidth=1.5;strokeDashed=1;dashed=1;endArrow=none;" edge="1" parent="1" source="n2_gm" target="n2_legal"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="u2_chess" value="&lt;b&gt;產品線．棋牌類：鬥陣歡樂城．鑫鬥陣&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#a8372b'&gt;&lt;b&gt;棋牌類 ｜ 產品負責人：謝欣燁 ｜ 代理人：陳建州&lt;/b&gt;&lt;/font&gt;" style="swimlane;horizontal=1;startSize=40;html=1;whiteSpace=wrap;fillColor=#f8e7e4;fontColor=#a8372b;swimlaneFillColor=#FAF7F2;strokeColor=#a8372b;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=12;fontStyle=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="50" y="190" width="420" height="460" as="geometry" /></mxCell><mxCell id="u2_chess_body" value="&lt;div style='font-family:Noto Sans TC; font-size:10.5px; line-height:1.5; color:#2B2B2B;'&gt;&lt;div style='font-weight:bold; color:#a8372b; border-bottom:1px dashed #cfd5e0; padding-bottom:3px; margin-bottom:8px;'&gt;企劃組&lt;/div&gt;• &lt;b&gt;謝欣燁 (A071)&lt;/b&gt; &lt;font color='#a8372b'&gt;[主責 / 產品負責人]&lt;/font&gt;&lt;br&gt;• &lt;b&gt;陳建州 (A002)&lt;/b&gt; &lt;font color='#5d6779'&gt;[協同企劃]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;div style='font-weight:bold; color:#a8372b; border-bottom:1px dashed #cfd5e0; padding-bottom:3px; margin-bottom:8px;'&gt;營運 ． 推廣組&lt;/div&gt;• &lt;b&gt;謝欣燁 (A071)&lt;/b&gt; &lt;font color='#5d6779'&gt;兼營運、推廣&lt;/font&gt;（AMS後台/開桌/防作弊監控）&lt;br&gt;• &lt;b&gt;陳建州 (A002)&lt;/b&gt; &lt;font color='#5d6779'&gt;兼營運、推廣&lt;/font&gt;（商務加盟/合規管理）&lt;br&gt;&lt;br&gt;&lt;div style='background:#f8e7e4; border-left:3px solid #a8372b; padding:6px 8px; font-size:9.5px; color:#a8372b; margin-top:20px;'&gt;&lt;b&gt;專屬人力：0 人&lt;/b&gt;&lt;br&gt;企劃與營運由兩位主管兼任；研發、測試、客服調用共用單位。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8AFA3;strokeWidth=1;fontColor=#2B2B2B;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="u2_chess"><mxGeometry x="15" y="55" width="390" height="385" as="geometry" /></mxCell><mxCell id="u2_pet" value="&lt;b&gt;產品線：寵物遊戲&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#22705f'&gt;&lt;b&gt;寵物類 ｜ 產品負責人：張哲豪 ｜ 代理人：曾翊庭&lt;/b&gt;&lt;/font&gt;" style="swimlane;horizontal=1;startSize=40;html=1;whiteSpace=wrap;fillColor=#e1f1ec;fontColor=#22705f;swimlaneFillColor=#FAF7F2;strokeColor=#22705f;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=12;fontStyle=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="490" y="190" width="390" height="460" as="geometry" /></mxCell><mxCell id="u2_pet_body" value="&lt;div style='font-family:Noto Sans TC; font-size:10.5px; line-height:1.5; color:#2B2B2B;'&gt;&lt;div style='font-weight:bold; color:#22705f; border-bottom:1px dashed #cfd5e0; padding-bottom:3px; margin-bottom:8px;'&gt;企劃 ． 營運 ． 推廣組&lt;/div&gt;• &lt;b&gt;張哲豪 (A060)&lt;/b&gt; &lt;font color='#22705f'&gt;&lt;b&gt;【產品負責人 / 部門主管】&lt;/b&gt;&lt;/font&gt;&lt;br&gt;　主責養成數值、經濟系統、玩法規則，兼任營運與推廣策略&lt;br&gt;&lt;br&gt;• &lt;b&gt;曾翊庭 (A033)&lt;/b&gt; &lt;font color='#5d6779'&gt;[系統企劃專員 / (進階)]&lt;/font&gt;&lt;br&gt;　寵物內容規劃、活動規格書、社群互動設計，兼營運推廣執行&lt;br&gt;&lt;br&gt;&lt;div style='background:#e1f1ec; border-left:3px solid #22705f; padding:6px 8px; font-size:9.5px; color:#22705f; margin-top:35px;'&gt;&lt;b&gt;專屬人力：2 人&lt;/b&gt;&lt;br&gt;企劃部 2 人全力投入寵物遊戲；研發與客服同樣調用共用中心。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8AFA3;strokeWidth=1;fontColor=#2B2B2B;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="u2_pet"><mxGeometry x="15" y="55" width="360" height="385" as="geometry" /></mxCell><mxCell id="u2_rd" value="&lt;b&gt;共用單位：技術部 (服務兩款)&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#1f3864'&gt;&lt;b&gt;統籌主管：副總經理 廖倫豪 博士 (B026)&lt;/b&gt;&lt;/font&gt;" style="swimlane;horizontal=1;startSize=40;html=1;whiteSpace=wrap;fillColor=#eceff5;fontColor=#1f3864;swimlaneFillColor=#FAF7F2;strokeColor=#1f3864;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=12;fontStyle=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="900" y="190" width="580" height="460" as="geometry" /></mxCell><mxCell id="u2_rd_body" value="&lt;div style='font-family:Noto Sans TC; font-size:10px; line-height:1.45; color:#2B2B2B;'&gt;&lt;div style='display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:8px;'&gt;&lt;div&gt;&lt;div style='font-weight:bold; color:#1f3864; border-bottom:1px dashed #cfd5e0; padding-bottom:2px; margin-bottom:5px;'&gt;開發組 (4人)&lt;/div&gt;• &lt;b&gt;趙柏凱 (A022)&lt;/b&gt; [主管]&lt;br&gt;　CSPRNG洗牌、牌局排程&lt;br&gt;• &lt;b&gt;林秉韶 (A051 代理人)&lt;/b&gt; [(進階)]&lt;br&gt;　Unity/Cocos客戶端&lt;br&gt;• &lt;b&gt;鄭元翔 (A066)&lt;/b&gt; [(進階)]&lt;br&gt;　微服務、兼數據分析&lt;br&gt;• &lt;b&gt;林琮緯 (B029 代理人)&lt;/b&gt; [(基礎)]&lt;br&gt;　DevOps、K8s、CI/CD&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div style='font-weight:bold; color:#1f3864; border-bottom:1px dashed #cfd5e0; padding-bottom:2px; margin-bottom:5px;'&gt;美術組 (4人)&lt;/div&gt;• &lt;b&gt;魏淑禎 (A011)&lt;/b&gt; [主管]&lt;br&gt;　視覺總監、風格適配審查&lt;br&gt;• &lt;b&gt;潘羿彰 (A012 代理人)&lt;/b&gt; [(進階)]&lt;br&gt;　角色場景原畫設定&lt;br&gt;• &lt;b&gt;陳俞任 (A057)&lt;/b&gt; [(進階)]&lt;br&gt;　UI/UX 介面切圖規範&lt;br&gt;• &lt;b&gt;張丞佑 (A068)&lt;/b&gt; [(基礎)]&lt;br&gt;　Spine骨骼動畫、粒子特效&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div style='font-weight:bold; color:#1f3864; border-bottom:1px dashed #cfd5e0; padding-bottom:2px; margin-bottom:5px;'&gt;測試組 (2人)&lt;/div&gt;• &lt;b&gt;凃睿修 (A049)&lt;/b&gt; [主管]&lt;br&gt;　黑白盒測試、自動化測試&lt;br&gt;• &lt;b&gt;蕭智瑜 (B030 代理人)&lt;/b&gt; [(基礎)]&lt;br&gt;　真機機庫壓測、Blocker歸零&lt;br&gt;&lt;br&gt;&lt;div style='font-weight:bold; color:#2F4538; border-bottom:1px dashed #cfd5e0; padding-bottom:2px; margin-bottom:3px;'&gt;中心統籌&lt;/div&gt;• &lt;b&gt;廖倫豪 博士&lt;/b&gt;&lt;br&gt;　副總經理 / 兼資安主管&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style='background:#eceff5; border-left:3px solid #1f3864; padding:6px 8px; font-size:9.5px; color:#1f3864; margin-top:12px;'&gt;&lt;b&gt;總人數：11 人&lt;/b&gt;（副總經理統籌）&lt;br&gt;工作內容與排程依兩款產品負責人需求，由副總經理（廖倫豪 博士）排定跨產品優先順序。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8AFA3;strokeWidth=1;fontColor=#2B2B2B;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="u2_rd"><mxGeometry x="15" y="55" width="550" height="385" as="geometry" /></mxCell><mxCell id="u2_cs" value="&lt;b&gt;共用單位：客服部 (服務兩款)&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#1f3864'&gt;&lt;b&gt;主管：謝欣燁 (A071)&lt;/b&gt;&lt;/font&gt;" style="swimlane;horizontal=1;startSize=40;html=1;whiteSpace=wrap;fillColor=#eceff5;fontColor=#1f3864;swimlaneFillColor=#FAF7F2;strokeColor=#1f3864;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=12;fontStyle=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1500" y="190" width="380" height="460" as="geometry" /></mxCell><mxCell id="u2_cs_body" value="&lt;div style='font-family:Noto Sans TC; font-size:10.5px; line-height:1.5; color:#2B2B2B;'&gt;&lt;div style='font-weight:bold; color:#1f3864; border-bottom:1px dashed #cfd5e0; padding-bottom:3px; margin-bottom:8px;'&gt;玩家客服 ． 爭議協查組 (4人)&lt;/div&gt;• &lt;b&gt;謝欣燁 (A071)&lt;/b&gt; [主管] 統籌客服排班、客訴督導、作弊判定&lt;br&gt;• &lt;b&gt;張晉杰 (A081 代理人)&lt;/b&gt; [(基礎)] 7x24 第一線玩家諮詢、斷線排查&lt;br&gt;• &lt;b&gt;耿舜儀 (A086)&lt;/b&gt; [(基礎)] 俱樂部代理商諮詢、開桌異常處理&lt;br&gt;• &lt;b&gt;吳玟儀 (A090)&lt;/b&gt; [(基礎)] 同 IP/GPS 夥牌監控仲裁、儲值協查&lt;br&gt;&lt;br&gt;&lt;div style='background:#eceff5; border-left:3px solid #1f3864; padding:6px 8px; font-size:9.5px; color:#1f3864; margin-top:20px;'&gt;&lt;b&gt;總人數：4 人&lt;/b&gt;&lt;br&gt;客服案件依產品線（棋牌 vs 寵物）分類受理，定期回報兩款負責人。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8AFA3;strokeWidth=1;fontColor=#2B2B2B;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="u2_cs"><mxGeometry x="15" y="55" width="350" height="385" as="geometry" /></mxCell><mxCell id="u2_admin" value="&lt;b&gt;公司共用：管理部 (行政支援)&lt;/b&gt;&lt;br&gt;&lt;font size='10' color='#5d6779'&gt;&lt;b&gt;直屬總經理 ． 副總經理廖倫豪審簽&lt;/b&gt;&lt;/font&gt;" style="swimlane;horizontal=1;startSize=40;html=1;whiteSpace=wrap;fillColor=#f1eee6;fontColor=#5d6779;swimlaneFillColor=#FAF7F2;strokeColor=#5d6779;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=12;fontStyle=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1900" y="190" width="450" height="460" as="geometry" /></mxCell><mxCell id="u2_admin_body" value="&lt;div style='font-family:Noto Sans TC; font-size:10px; line-height:1.45; color:#2B2B2B;'&gt;&lt;div style='display:grid; grid-template-columns:1fr 1fr; gap:12px;'&gt;&lt;div&gt;&lt;div style='font-weight:bold; color:#5d6779; border-bottom:1px dashed #cfd5e0; padding-bottom:2px; margin-bottom:5px;'&gt;管理部 (4人)&lt;/div&gt;• &lt;b&gt;陳建州 (A002)&lt;/b&gt; [主管]&lt;br&gt;　行政總務管理、資產印鑑&lt;br&gt;• &lt;b&gt;楊芮郗 (A076)&lt;/b&gt; [(進階)]&lt;br&gt;　總務採購比價、耗材盤點&lt;br&gt;• &lt;b&gt;王韻庭 (A088)&lt;/b&gt; [(基礎)]&lt;br&gt;　公司前台、包裹代收登記&lt;br&gt;• &lt;b&gt;印厚承 (A087)&lt;/b&gt; [(進階)]&lt;br&gt;　設備水電維護、公務司機&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div style='font-weight:bold; color:#5d6779; border-bottom:1px dashed #cfd5e0; padding-bottom:2px; margin-bottom:5px;'&gt;財務部 (3人)&lt;/div&gt;• &lt;b&gt;王慈汶 (A003)&lt;/b&gt; [主管]&lt;br&gt;　網銀放行Checker、主檔覆核&lt;br&gt;• &lt;b&gt;賴盈築 (A084)&lt;/b&gt; [(進階)]&lt;br&gt;　出納製單Maker、薪資撥款&lt;br&gt;• &lt;b&gt;游玉霜 (A082 代理人)&lt;/b&gt; [(基礎)]&lt;br&gt;　AP應付帳款、IFRS 15結轉&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style='background:#f1eee6; border-left:3px solid #5d6779; padding:6px 8px; font-size:9.5px; color:#5d6779; margin-top:20px;'&gt;&lt;b&gt;總人數：7 人&lt;/b&gt;&lt;br&gt;直屬總經理；簽核文件先經副總經理審簽，再呈總經理核定。支援全公司不分產品。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8AFA3;strokeWidth=1;fontColor=#2B2B2B;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="u2_admin"><mxGeometry x="15" y="55" width="420" height="385" as="geometry" /></mxCell><mxCell id="e2_gm_u2_chess" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6E6A64;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n2_gm" target="u2_chess"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_gm_u2_pet" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6E6A64;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n2_gm" target="u2_pet"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_gm_u2_rd" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6E6A64;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n2_gm" target="u2_rd"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_gm_u2_cs" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6E6A64;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n2_gm" target="u2_cs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_gm_u2_admin" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6E6A64;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n2_gm" target="u2_admin"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d2_m2_title" value="&lt;b&gt;二、產品線 × 職能部門弱矩陣對照表 (Product Line × Functional Matrix)&lt;/b&gt;" style="text;html=1;fontFamily=Noto Sans TC;fontSize=15;fontStyle=1;fontColor=#1f3864;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="680" width="1200" height="28" as="geometry" /></mxCell><mxCell id="d2_matrix_table" value="&lt;table style='width:100%; border-collapse:collapse; font-family:Noto Sans TC; font-size:11px; border:1px solid #cfd5e0;'&gt;&lt;tr style='background:#1f3864; color:#fff;'&gt;&lt;th style='padding:8px; width:170px;'&gt;產品線&lt;/th&gt;&lt;th style='padding:8px;'&gt;企劃&lt;/th&gt;&lt;th style='padding:8px;'&gt;營運 ． 推廣&lt;/th&gt;&lt;th style='padding:8px;'&gt;技術 (研發)&lt;br&gt;&lt;span style='font-size:9.5px; opacity:0.85;'&gt;主管 趙柏凱&lt;/span&gt;&lt;/th&gt;&lt;th style='padding:8px;'&gt;美術 (視覺)&lt;br&gt;&lt;span style='font-size:9.5px; opacity:0.85;'&gt;主管 魏淑禎&lt;/span&gt;&lt;/th&gt;&lt;th style='padding:8px;'&gt;測試 (QA)&lt;br&gt;&lt;span style='font-size:9.5px; opacity:0.85;'&gt;主管 凃睿修&lt;/span&gt;&lt;/th&gt;&lt;th style='padding:8px;'&gt;客服 (支援)&lt;br&gt;&lt;span style='font-size:9.5px; opacity:0.85;'&gt;主管 謝欣燁&lt;/span&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr style='background:#fdf9f8;'&gt;&lt;td style='padding:8px; font-weight:bold; color:#a8372b; background:#f8e7e4;'&gt;&lt;b&gt;鬥陣歡樂城．鑫鬥陣&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9.5px; color:#5d6779;'&gt;棋牌類&lt;br&gt;產品負責人：謝欣燁 ｜ 代理人：陳建州&lt;/span&gt;&lt;/td&gt;&lt;td style='padding:8px;'&gt;• &lt;b&gt;謝欣燁 (A071)&lt;/b&gt; [主責]&lt;br&gt;• 陳建州 (A002)&lt;/td&gt;&lt;td style='padding:8px;'&gt;• &lt;b&gt;謝欣燁 (A071)&lt;/b&gt; [兼營運、推廣]&lt;br&gt;• &lt;b&gt;陳建州 (A002)&lt;/b&gt; [兼營運、推廣]&lt;/td&gt;&lt;td rowspan='2' style='padding:8px; background:#eceff5; vertical-align:middle;'&gt;• &lt;b&gt;趙柏凱 (A022)&lt;/b&gt; [主管]&lt;br&gt;• 林秉韶 (A051 代理人) [前端]&lt;br&gt;• 鄭元翔 (A066) [MIS／SRE／數據]&lt;br&gt;• 林琮緯 (B029 代理人) [MIS／SRE／數據]&lt;br&gt;&lt;span style='display:inline-block; background:#1f3864; color:#fff; font-size:9px; padding:1px 6px; border-radius:3px; margin-top:4px;'&gt;兩款共用 (4人)&lt;/span&gt;&lt;/td&gt;&lt;td rowspan='2' style='padding:8px; background:#eceff5; vertical-align:middle;'&gt;• &lt;b&gt;魏淑禎 (A011)&lt;/b&gt; [主管]&lt;br&gt;• 潘羿彰 (A012 代理人) [原畫]&lt;br&gt;• 陳俞任 (A057) [UI/UX]&lt;br&gt;• 張丞佑 (A068) [動態特效]&lt;br&gt;&lt;span style='display:inline-block; background:#1f3864; color:#fff; font-size:9px; padding:1px 6px; border-radius:3px; margin-top:4px;'&gt;兩款共用 (4人)&lt;/span&gt;&lt;/td&gt;&lt;td rowspan='2' style='padding:8px; background:#eceff5; vertical-align:middle;'&gt;• &lt;b&gt;凃睿修 (A049)&lt;/b&gt; [主管]&lt;br&gt;• 蕭智瑜 (B030 代理人) [QA工程師]&lt;br&gt;• 曾翊庭 [兼任企劃]&lt;br&gt;&lt;span style='display:inline-block; background:#1f3864; color:#fff; font-size:9px; padding:1px 6px; border-radius:3px; margin-top:4px;'&gt;兩款共用 (2人)&lt;/span&gt;&lt;/td&gt;&lt;td rowspan='2' style='padding:8px; background:#eceff5; vertical-align:middle;'&gt;• &lt;b&gt;謝欣燁 (A071)&lt;/b&gt; [主管]&lt;br&gt;• 張晉杰 (A081 代理人)&lt;br&gt;• 耿舜儀 (A086)&lt;br&gt;• 吳玟儀 (A090)&lt;br&gt;&lt;span style='display:inline-block; background:#1f3864; color:#fff; font-size:9px; padding:1px 6px; border-radius:3px; margin-top:4px;'&gt;兩款共用 (4人)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f7fbf9;'&gt;&lt;td style='padding:8px; font-weight:bold; color:#22705f; background:#e1f1ec;'&gt;&lt;b&gt;寵物遊戲&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9.5px; color:#5d6779;'&gt;寵物類&lt;br&gt;產品負責人：張哲豪 ｜ 代理人：曾翊庭&lt;/span&gt;&lt;/td&gt;&lt;td style='padding:8px;'&gt;• &lt;b&gt;張哲豪 (A060)&lt;/b&gt; [主責]&lt;br&gt;• 曾翊庭 (A033)&lt;/td&gt;&lt;td style='padding:8px;'&gt;• &lt;b&gt;張哲豪&lt;/b&gt; (兼營運、推廣)&lt;br&gt;• 曾翊庭 (兼營運、推廣)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f1eee6;'&gt;&lt;td style='padding:8px; font-weight:bold; color:#5d6779;'&gt;公司共用&lt;br&gt;&lt;span style='font-size:9.5px;'&gt;直屬總經理 ． 副總經理審簽&lt;/span&gt;&lt;/td&gt;&lt;td colspan='6' style='padding:8px; color:#2B2B2B;'&gt;• &lt;b&gt;管理部（陳建州 主管）&lt;/b&gt;：楊芮郗 (A076 代理人) ． 王韻庭 (A088 前台) ． 印厚承 (A087 司機/設備)&lt;br&gt;• &lt;b&gt;財務部（王慈汶 主管）&lt;/b&gt;：賴盈築 (A084 出納製單) ． 游玉霜 (A082 會計AP/營收結轉)&lt;br&gt;• &lt;b&gt;法務&lt;/b&gt;：委外律師，直接由總經理委任支援全公司&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8AFA3;strokeWidth=1.5;fontColor=#2B2B2B;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="715" width="2300" height="220" as="geometry" /></mxCell><mxCell id="d2_m3_title" value="&lt;b&gt;三、弱矩陣三大運作規則 (Operational Rules)&lt;/b&gt;" style="text;html=1;fontFamily=Noto Sans TC;fontSize=15;fontStyle=1;fontColor=#1f3864;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="960" width="1200" height="28" as="geometry" /></mxCell><mxCell id="d2_rule_0" value="&lt;div style='font-family:Noto Sans TC; padding:6px 8px;'&gt;&lt;div style='font-size:13px; font-weight:bold; color:#1f3864; margin-bottom:6px;'&gt;雙線報告與研發排程&lt;/div&gt;&lt;div style='font-size:10.5px; color:#333; line-height:1.5;'&gt;研發同仁的人事、考勤與職能評鑑由職能主管（趙柏凱/魏淑禎/凃睿修）負責；工作內容依兩款產品的需求，在每週或每雙週的排程會議上由廖倫豪定優先順序。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eceff5;strokeColor=#1f3864;strokeWidth=1.5;fontColor=#2B2B2B;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="995" width="740" height="105" as="geometry" /></mxCell><mxCell id="d2_rule_1" value="&lt;div style='font-family:Noto Sans TC; padding:6px 8px;'&gt;&lt;div style='font-size:13px; font-weight:bold; color:#1f3864; margin-bottom:6px;'&gt;簽核流程與審簽機制&lt;/div&gt;&lt;div style='font-size:10.5px; color:#333; line-height:1.5;'&gt;管理部、財務部直屬總經理，簽核文件先經副總經理廖倫豪審簽，再呈總經理核決。法務委外，由總經理直接委任。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eceff5;strokeColor=#1f3864;strokeWidth=1.5;fontColor=#2B2B2B;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="830" y="995" width="740" height="105" as="geometry" /></mxCell><mxCell id="d2_rule_2" value="&lt;div style='font-family:Noto Sans TC; padding:6px 8px;'&gt;&lt;div style='font-size:13px; font-weight:bold; color:#1f3864; margin-bottom:6px;'&gt;客服共用與分流回報&lt;/div&gt;&lt;div style='font-size:10.5px; color:#333; line-height:1.5;'&gt;客服案件依產品線（棋牌 vs 寵物）分類受理並訂定處理時效 SLA，定期將客訴與爭議數據摘要分別回報給兩款產品負責人。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eceff5;strokeColor=#1f3864;strokeWidth=1.5;fontColor=#2B2B2B;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1610" y="995" width="740" height="105" as="geometry" /></mxCell><mxCell id="d2_author" value="Howard Liao Ph.D. ｜ 盛欣、盛碁科技網絡 制度管理委員會 謹訂" style="text;html=1;fontFamily=Cormorant Garamond, serif;fontSize=14;fontStyle=3;fontColor=#5d6779;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="1130" width="600" height="25" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>