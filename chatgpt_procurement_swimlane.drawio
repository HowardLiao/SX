        <!-- POOL CONTAINER -->
        <mxCell id="pool" value="盛欣網絡 採購 ChatGPT / 企業級 AI 工具 端到端作業泳道圖 (ISO 42001 &amp;amp; 內控採購循環)" 
                style="swimlane;html=1;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;startSize=40;horizontal=1;fontColor=#ffffff;fontSize=18;fontStyle=1;strokeColor=#d97706;fillColor=#1f130b;collapsible=0;marginBottom=0;" 
