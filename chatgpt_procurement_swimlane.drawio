        <mxCell id="node_fin_0" value="&lt;b&gt;【預算勾稽】&lt;/b&gt;&lt;br&gt;檢核年度軟體研發科目&lt;br&gt;確認預算餘額充足" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;fontColor=#ffffff;fontSize=12;align=left;spacing=10;" 
