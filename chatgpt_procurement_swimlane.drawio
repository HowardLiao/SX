          <mxGeometry x="0" y="675" width="1600" height="155" as="geometry" />
        </mxCell>

        <!-- ==================== LANE 1 NODES (TECH) ==================== -->
        <mxCell id="node_tech_1" value="&lt;b&gt;STEP 01: 提報請購與選型&lt;/b&gt;&lt;br&gt;• 確定方案 (Team / API)&lt;br&gt;• 評估研發效益與席位清冊&lt;br&gt;&lt;font color='#34d399'&gt;&lt;b&gt;[表單] FM-PUR-01 請購單&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#fca5a5'&gt;檢附：AI工具效益評估表&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#38bdf8;strokeWidth=2;fontColor=#ffffff;fontSize=12;align=left;spacing=10;" 
                vertex="1" parent="lane_tech">
          <mxGeometry x="120" y="25" width="240" height="105" as="geometry" />
        </mxCell>

        <mxCell id="node_tech_2" value="&lt;b&gt;STEP 03-B: 公務帳號註冊與席位開通&lt;/b&gt;&lt;br&gt;• 使用公司網域公務信箱註冊&lt;br&gt;• 強制啟用 SSO / MFA 雙因子認證&lt;br&gt;• 配置工程師席位 / API 預算硬上限&lt;br&gt;&lt;font color='#fca5a5'&gt;&lt;b&gt;★ 嚴禁用個人帳號／API設上限&lt;/b&gt;&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#38bdf8;strokeWidth=2;fontColor=#ffffff;fontSize=12;align=left;spacing=10;" 
                vertex="1" parent="lane_tech">
          <mxGeometry x="720" y="25" width="250" height="105" as="geometry" />
        </mxCell>

        <mxCell id="node_tech_3" value="&lt;b&gt;STEP 04: 功能測試與簽發驗收&lt;/b&gt;&lt;br&gt;• 測試代碼補全與API回應正常&lt;br&gt;• 檢附 Workspace 席位名冊截圖&lt;br&gt;&lt;font color='#34d399'&gt;&lt;b&gt;[表單] FM-PUR-06 驗收證明單 (GRN)&lt;/b&gt;&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#38bdf8;strokeWidth=2;fontColor=#ffffff;fontSize=12;align=left;spacing=10;" 
                vertex="1" parent="lane_tech">
          <mxGeometry x="1050" y="25" width="250" height="105" as="geometry" />
        </mxCell>

        <!-- ==================== LANE 2 NODES (SECURITY) ==================== -->
        <mxCell id="node_sec_1" value="&lt;b&gt;STEP 02: 資料主權審查&lt;/b&gt;&lt;br&gt;(ISO 42001 合規)&lt;br&gt;&lt;b&gt;◆ 判定：承諾不訓練？&lt;/b&gt;&lt;br&gt;(Zero Data Training)" 
                style="rhombus;whiteSpace=wrap;html=1;fillColor=#451a1a;strokeColor=#ef4444;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;" 
                vertex="1" parent="lane_sec">
          <mxGeometry x="420" y="20" width="220" height="115" as="geometry" />
        </mxCell>

        <mxCell id="node_sec_reject" value="&lt;b&gt;【退件駁回】&lt;/b&gt;&lt;br&gt;嚴禁購買個人版&lt;br&gt;(ChatGPT Plus/Pro)&lt;br&gt;防止原始碼外洩！" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#581c1c;strokeColor=#ef4444;strokeWidth=2;fontColor=#fca5a5;fontSize=11;align=center;" 
                vertex="1" parent="lane_sec">
          <mxGeometry x="160" y="40" width="180" height="75" as="geometry" />
        </mxCell>

        <!-- ==================== LANE 3 NODES (PROCUREMENT) ==================== -->
        <mxCell id="node_pur_1" value="&lt;b&gt;STEP 03-A: 單一來源立案與發單&lt;/b&gt;&lt;br&gt;• 原廠專有服務免三家比價&lt;br&gt;• 核發正式採購單 (PO)&lt;br&gt;• 授權綁定公務信用卡扣款&lt;br&gt;&lt;font color='#34d399'&gt;&lt;b&gt;[表單] FM-PUR-04 採購單 (PO)&lt;/b&gt;&lt;/font&gt;" 
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b2609;strokeColor=#f59e0b;strokeWidth=2;fontColor=#ffffff;fontSize=12;align=left;spacing=10;" 
